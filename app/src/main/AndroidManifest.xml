<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Essential Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Optional: For emergency calls -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- For background location (if needed for driver tracking) -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- For offline map caching with osmdroid -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <!-- Hardware Features (FIX for the warning) -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AmbuPlus"
        tools:targetApi="31"
        android:usesCleartextTraffic="true">

        <!-- Splash Activity (NEW LAUNCHER) -->
        <activity
            android:name=".uiactivities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AmbuPlus">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Activity -->
        <activity
            android:name=".uiactivities.main.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.AmbuPlus"
            android:launchMode="singleTop">
<!--            <intent-filter>-->
<!--                <action android:name="android.intent.action.MAIN" />-->
<!--                <category android:name="android.intent.category.LAUNCHER" />-->
<!--            </intent-filter>-->
        </activity>

        <!-- Login Activity -->
        <activity
            android:name=".uiactivities.login.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.AmbuPlus"
            android:launchMode="singleTop" />

        <activity
            android:name=".uiactivities.login.ResetPasswordActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.AmbuPlus">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ambuplus" android:host="reset-password" />
            </intent-filter>
        </activity>

        <!-- Request Activity -->
        <activity
            android:name=".uiactivities.request.RequestActivity"
            android:exported="false"
            android:theme="@style/Theme.AmbuPlus" />

        <!-- Map Location Picker Activity -->
        <activity
            android:name=".uiactivities.request.MapLocationPickerActivity"
            android:exported="false"
            android:theme="@style/Theme.AmbuPlus" />

        <!-- Request Detail Activity -->
        <activity
            android:name=".uiactivities.request.RequestDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.AmbuPlus" />

        <!-- Driver Activities -->
        <activity
            android:name=".uiactivities.driver.DriverActivity"
            android:exported="false"
            android:theme="@style/Theme.AmbuPlus" />

        <activity
            android:name=".uiactivities.driver.DriverRegistrationActivity"
            android:exported="false" />

        <activity
            android:name=".uiactivities.driver.DriverRatingsActivity"
            android:exported="false" />

        <activity
            android:name=".uiactivities.driver.DriverProfileActivity"
            android:exported="false" />

        <!-- Driver Requests Activity -->
        <activity
            android:name=".uiactivities.driver.DriverRequestsActivity"
            android:exported="false" />

        <!-- Driver Tracking Activity (NEW - for live ambulance tracking) -->
        <activity
            android:name=".uiactivities.driver.DriverTrackingActivity"
            android:exported="false"
            android:theme="@style/Theme.AmbuPlus" />

        <!-- Patient Tracking Activity (NEW - for patient to track ambulance) -->
        <activity
            android:name=".uiactivities.patient.PatientTrackingActivity"
            android:exported="false"
            android:theme="@style/Theme.AmbuPlus" />

        <!-- Add these meta-data for Google Maps (keep if you still need Google Maps) -->
<!--        <meta-data-->
<!--            android:name="com.google.android.geo.API_KEY"-->
<!--            android:value="YOUR_GOOGLE_MAPS_API_KEY_HERE" />-->

        <!-- Location service requirements -->
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />

        <!-- osmdroid configuration for offline map caching -->
        <meta-data
            android:name="osmdroid.cache.path"
            android:value="osmdroid_cache" />

    </application>

</manifest>