<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Available Requests"
        android:textSize="24sp"
        android:textColor="#E53935"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

<!--    &lt;!&ndash; Temporary Debug Button - Remove after fix &ndash;&gt;-->
<!--    &lt;!&ndash; Debug Button to Clear Stuck Resume Trip &ndash;&gt;-->
<!--    <Button-->
<!--        android:id="@+id/btnClearStuckTrip"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="48dp"-->
<!--        android:text="🔧 CLEAR STUCK RESUME TRIP"-->
<!--        android:textSize="12sp"-->
<!--        android:textStyle="bold"-->
<!--        android:background="#FF9800"-->
<!--        android:textColor="#FFFFFF"-->
<!--        android:layout_marginBottom="8dp" />-->

    <!-- Resume Active Trip Button (appears only when there's an active trip) -->
    <Button
        android:id="@+id/btnResumeTrip"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Resume Active Trip"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="#4CAF50"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp"
        android:visibility="gone" />

    <!-- Refresh Button -->
    <Button
        android:id="@+id/btnRefresh"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="REFRESH REQUESTS"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="#E53935"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp" />

    <!-- Requests List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRequests"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Empty State -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No pending requests available"
            android:textSize="16sp"
            android:textColor="#666666"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:padding="16dp" />

    </ScrollView>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</LinearLayout>